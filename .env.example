# PayPal Sandbox — from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional: paste a fresh token (expires ~8–9h). Prefer generating via `npm run token`.
PAYPAL_SANDBOX_ACCESS_TOKEN=

# Server
PORT=3030
PUBLIC_BASE_URL=http://127.0.0.1:3030

# Webhook ID from Developer Dashboard (after you register the ngrok URL)
PAYPAL_WEBHOOK_ID=

# Demo vendor probe — set FAIL to force poison-pill VOID path
PROBE_MODE=pass
# PROBE_MODE=fail
PROBE_URL=http://127.0.0.1:3030/demo/vendor/health

# Personal sandbox buyer — must Approve wallet checkouts + open disputes
SANDBOX_BUYER_EMAIL=

# Sandbox PayPal emails for Phase C micro-splits (Dashboard → Sandbox → Accounts)
PAYOUT_AGENT_A=
PAYOUT_AGENT_B=
PAYOUT_AGENT_C=
